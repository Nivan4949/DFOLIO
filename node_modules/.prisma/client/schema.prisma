datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("SITE_ENGINEER") // ADMIN, PROJECT_MANAGER, SITE_ENGINEER (SUPERVISOR), CONTRACTOR, CLIENT, LABOUR
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  assignedTasks   Task[]    @relation("AssignedTasks")
  contractorTasks Task[]    @relation("ContractorTasks")
  supervisorTasks Task[]    @relation("SupervisorTasks")
  createdTasks    Task[]    @relation("CreatedTasks")
  assignedSnags   Snag[]    @relation("AssignedSnags")
  createdSnags    Snag[]    @relation("CreatedSnags")
  photos          Photo[]
  notes           Note[]
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, SUSPENDED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  floors      Floor[]
  tasks       Task[]
  snags       Snag[]
}

model Floor {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Ground Floor", "1st Floor"
  number    Int      // e.g. 0, 1, 2
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  rooms     Room[]

  @@index([projectId])
}

model Room {
  id        String   @id @default(uuid())
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Kitchen", "Bathroom 1"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  tasks     Task[]
  snags     Snag[]

  @@index([floorId])
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique // e.g. "Plumbing", "Electrical"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  subWorks  SubWork[]
}

model SubWork {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Piping", "Switchboards"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  tasks      Task[]

  @@index([categoryId])
}

model Task {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  subWorkId    String?
  subWork      SubWork?  @relation(fields: [subWorkId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  startDate    DateTime
  endDate      DateTime
  status       String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, HOLD, INSPECTION, COMPLETED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  progress     Float     @default(0.0) // 0 to 100
  
  dependsOnTaskId String?
  dependsOnTask   Task?   @relation("TaskDependencies", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  dependentTasks  Task[]  @relation("TaskDependencies")
  
  contractorId String?
  contractor   User?     @relation("ContractorTasks", fields: [contractorId], references: [id], onDelete: SetNull)
  supervisorId String?
  supervisor   User?     @relation("SupervisorTasks", fields: [supervisorId], references: [id], onDelete: SetNull)
  labourCount  Int       @default(1)
  
  createdById  String
  createdBy    User      @relation("CreatedTasks", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  photos       Photo[]
  notes        Note[]
  snags        Snag[]

  @@index([projectId])
  @@index([roomId])
  @@index([subWorkId])
  @@index([status])
  @@index([contractorId])
  @@index([supervisorId])
}

model Snag {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  status       String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate      DateTime?
  
  createdById  String
  createdBy    User      @relation("CreatedSnags", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("AssignedSnags", fields: [assignedToId], references: [id])
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  photos       Photo[]
  notes        Note[]

  @@index([projectId])
  @@index([roomId])
  @@index([status])
  @@index([assignedToId])
}

model Photo {
  id           String   @id @default(uuid())
  url          String
  caption      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snagId       String?
  snag         Snag?    @relation(fields: [snagId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([snagId])
}

model Note {
  id            String   @id @default(uuid())
  content       String
  attachmentUrl String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snagId       String?
  snag         Snag?    @relation(fields: [snagId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId])
  @@index([snagId])
}
