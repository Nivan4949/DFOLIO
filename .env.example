# Construction Execution Management System (DFOLIO) - Environment Configuration

# Server Port & Node Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Supabase / Neon / Local PostgreSQL)
# Pgbouncer transaction pooler (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?schema=dfolio&sslmode=require&pgbouncer=true"

# Direct PostgreSQL URL (port 5432) for Prisma DDL migrations (prisma db push)
DIRECT_URL="postgresql://postgres.xxx:xxx@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=dfolio&sslmode=require"

# JWT Authentication Secret
JWT_SECRET="dfolio_production_jwt_secret_key_change_in_prod_2026"

# Supabase Storage Credentials (dfolio-photos bucket)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"
SUPABASE_STORAGE_BUCKET="dfolio-photos"
